generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CapsuleStatus {
  LOCKED
  UNLOCKED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  capsules     Capsule[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Capsule {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String        @db.VarChar(255)
  contentText String?       @map("content_text") @db.Text
  openAt      DateTime      @map("open_at") @db.Timestamptz
  status      CapsuleStatus @default(LOCKED)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  attachments MediaAttachment[]

  @@index([userId])
  @@index([openAt])
  @@index([userId, status])
  @@map("capsules")
}

model MediaAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  capsuleId String   @map("capsule_id") @db.Uuid
  capsule   Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  fileKey   String   @map("file_key")
  fileName  String   @map("file_name")
  fileType  String   @map("file_type") @db.VarChar(127)
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([capsuleId])
  @@map("media_attachments")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}
