DATABASE_URL="postgresql://user:password@localhost:5432/timecapsule?schema=public"
JWT_ACCESS_SECRET="change-me-super-secret-access-32chars+"
JWT_REFRESH_SECRET="change-me-super-secret-refresh-32chars+"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# --- S3 privat (akses hanya via presigned URL) ---
AWS_REGION="ap-southeast-1"
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via env/IAM role
S3_BUCKET="timecapsule-private-media"
S3_UPLOAD_URL_TTL_SEC=900
S3_DOWNLOAD_URL_TTL_SEC=1200
S3_MAX_FILE_SIZE=104857600

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- SMTP (Nodemailer; kosong = log-only di dev) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Time Capsule <no-reply@timecapsule.local>"
